                "name": "Command Prompt"
            },
            {
                "colorScheme": "Catppuccin Mocha Plum",
                "commandline": "pwsh.exe -NoLogo -NoExit -File %USERPROFILE%\\.config\\powershell\\taskbar-window.ps1 -Name Launcher",
                "guid": "{edf58397-8a8b-4add-9754-f8f1f82dd5f4}",
