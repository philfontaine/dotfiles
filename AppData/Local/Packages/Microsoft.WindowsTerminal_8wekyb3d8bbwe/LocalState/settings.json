{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": 
    [
        {
            "command": 
            {
                "action": "sendInput",
                "input": "\u001b[46;5u"
            },
            "id": "User.SendCtrlPeriod"
        },
        {
            "command":
            {
                "action": "newTab",
                "commandline": "wt.exe -w neovim -p Neovim"
            },
            "icon": "ms-appdata:///Local/neovim.ico",
            "id": "User.OpenNeovimWindow",
            "name": "Neovim"
        },
        {
            "command":
            {
                "action": "newTab",
                "commandline": "wt.exe -w launcher -p Launcher"
            },
            "icon": "ms-appdata:///Local/launcher.ico",
            "id": "User.OpenLauncherWindow",
            "name": "Launcher"
        }
    ],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "disableAnimations": true,
    "keybindings": 
    [
        {
            "id": "Terminal.ResizePaneDown",
            "keys": "ctrl+alt+shift+j"
        },
        {
            "id": "Terminal.DuplicateTab",
            "keys": "ctrl+t"
        },
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+h"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+l"
        },
        {
            "id": "Terminal.MoveFocusLeft",
            "keys": "alt+shift+h"
        },
        {
            "id": "Terminal.DuplicatePaneRight",
            "keys": "ctrl+r"
        },
        {
            "id": "Terminal.DuplicatePaneDown",
            "keys": "ctrl+b"
        },
        {
            "id": "Terminal.MoveFocusDown",
            "keys": "alt+shift+j"
        },
        {
            "id": "Terminal.MoveFocusUp",
            "keys": "alt+shift+k"
        },
        {
            "id": "Terminal.MoveFocusRight",
            "keys": "alt+shift+l"
        },
        {
            "id": "Terminal.ClosePane",
            "keys": "ctrl+w"
        },
        {
            "id": "Terminal.ResizePaneLeft",
            "keys": "ctrl+alt+shift+h"
        },
        {
            "id": "Terminal.ResizePaneUp",
            "keys": "ctrl+alt+shift+k"
        },
        {
            "id": "Terminal.ResizePaneRight",
            "keys": "ctrl+alt+shift+l"
        },
        {
            "id": "Terminal.OpenTabRenamer",
            "keys": "f2"
        },
        {
            "id": "User.SendCtrlPeriod",
            "keys": "ctrl+."
        }
    ],
    "launchMode": "maximized",
    "newTabMenu": 
    [
        {
            "profile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
            "type": "profile"
        },
        {
            "id": "User.OpenNeovimWindow",
            "type": "action"
        },
        {
            "id": "User.OpenLauncherWindow",
            "type": "action"
        }
    ],
    "profiles": 
    {
        "defaults": 
        {
            "colorScheme": "Catppuccin Mocha Gray",
            "font": 
            {
                "axes": 
                {
                    "wght": 375
                },
                "face": "Geist Mono, GeistMono NF"
            },
            "tabColor": "#EF7A12",
