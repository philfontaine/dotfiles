            },
            {
                "colorScheme": "Catppuccin Mocha",
                "commandline": "pwsh.exe -NoLogo -NoExit -File %USERPROFILE%\\.config\\powershell\\taskbar-window.ps1 -Name Neovim",
                "guid": "{9a7500b7-ba6a-495b-962e-977af755bf15}",
                "hidden": true,
                "icon": "ms-appdata:///Local/neovim.ico",
                "name": "Neovim",
                "tabColor": "#B4BEFE",
                "unfocusedAppearance":
                {
                    "colorScheme": "Catppuccin Mocha Dim"
                }
            }
        ]
    },
